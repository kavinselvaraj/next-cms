{
  "format": "custom",
  "id": "content_page",
  "label": "Content Page",
  "repeatable": true,
  "status": true,
  "json": {
    "Heading": {
      "uid": {
        "type": "UID",
        "config": { "label": "UID", "placeholder": "content-page-slug" }
      },
      "breadcrumb_level_1_label": {
        "type": "Text",
        "config": { "label": "Breadcrumb Level 1 Label", "placeholder": "" }
      },
      "breadcrumb_level_1_href": {
        "type": "Text",
        "config": { "label": "Breadcrumb Level 1 Href", "placeholder": "" }
      },
      "breadcrumb_level_2_label": {
        "type": "Text",
        "config": { "label": "Breadcrumb Level 2 Label", "placeholder": "" }
      },
      "breadcrumb_level_2_href": {
        "type": "Text",
        "config": { "label": "Breadcrumb Level 2 Href", "placeholder": "" }
      },
      "breadcrumb_level_3_label": {
        "type": "Text",
        "config": { "label": "Breadcrumb Level 3 Label", "placeholder": "" }
      },
      "breadcrumb_level_3_href": {
        "type": "Text",
        "config": { "label": "Breadcrumb Level 3 Href", "placeholder": "" }
      },
      "heading": {
        "type": "Slices",
        "fieldset": "Heading Slice Zone",
        "config": {
          "choices": {
            "page_title": { "type": "SharedSlice" },
            "breadcrumbs": { "type": "SharedSlice" },
            "hero_banner": { "type": "SharedSlice" }
          }
        }
      }
    },
    "Main": {
      "main": {
        "type": "Slices",
        "fieldset": "Main Slice Zone",
        "config": {
          "choices": {
            "cta_banner": { "type": "SharedSlice" },
            "faq_question_list": { "type": "SharedSlice" }
          }
        }
      }
    },
    "Aside": {
      "aside": {
        "type": "Slices",
        "fieldset": "Aside Slice Zone",
        "config": {
          "choices": {
            "cta_banner": { "type": "SharedSlice" },
            "faq_question_list": { "type": "SharedSlice" }
          }
        }
      }
    },
    "Footer": {
      "footer": {
        "type": "Slices",
        "fieldset": "Footer Slice Zone",
        "config": {
          "choices": {
            "newsletter_signup": { "type": "SharedSlice" },
            "social_links": { "type": "SharedSlice" }
          }
        }
      }
    }
  }
}
